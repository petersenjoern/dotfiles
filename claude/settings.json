{
  "permissions": {
    "allow": [
      "Skill(superpowers:writing-plans)",
      "WebFetch(domain:turbopuffer.com)",
      "Bash(mkdir:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(touch:*)",
      "Bash(make check:*)",
      "Bash(make test:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(source .venv/bin/activate)",
      "Bash(python -m py_compile:*)",
      "Bash(python -m mypy:*)",
      "Bash(ruff check:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run pyright:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv sync:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cat:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(~/secrets.sh)",
      "Read(~/.zshrc)"
    ],
    "defaultMode": "auto"
  },
  "outputStyle": "default",
  "effortLevel": "high",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "OTEL_METRICS_EXPORTER": "otlp"
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": false,
    "superpowers@superpowers-marketplace": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'Claude Code' 'Awaiting your input'"
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/status_hook.py attention"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/status_hook.py attention"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/status_hook.py idle"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/pre_tool_use.py"
          },
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/status_hook.py working"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/post_tool_use.py",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ~/.claude/hooks/status_hook.py idle"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -n \"$TMUX_PANE\" && rm -f \"/tmp/claude-status/$TMUX_PANE\"; true"
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "doubt": "off",
    "failmodes": "off",
    "unsaid": "off"
  }
}
