export XDG_CONFIG_HOME=$HOME/.config
VIM="nvim"

# Source local configuration (fill in dotfiles.local.conf once per machine)
if [ -f "$HOME/repos/personal/dotfiles/dotfiles.local.conf" ]; then
    source "$HOME/repos/personal/dotfiles/dotfiles.local.conf"
elif [ -f "$HOME/.dotfiles.local.conf" ]; then
    source "$HOME/.dotfiles.local.conf"
fi

PERSONAL=$XDG_CONFIG_HOME/personal
DEV_ENV="${DOTFILES_REPOS_DIR:-$HOME/repos}/personal/dotfiles"

for i in `find -L $PERSONAL`; do
    source $i
done

## All that sweet sweet fzf
[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh
source ~/.local/share/fzf/key-bindings.zsh
source ~/.local/share/fzf/completion.zsh

export GOPATH=$HOME/.local/go
export GIT_EDITOR=$VIM

catr() {
    tail -n "+$1" $3 | head -n "$(($2 - $1 + 1))"
}

cat1Line() {
    cat $1 | tr -d "\n"
}


addToPath() {
    if [[ "$PATH" != *"$1"* ]]; then
        export PATH=$PATH:$1
    fi
}

addToPathFront() {
    if [[ ! -z "$2" ]] || [[ "$PATH" != *"$1"* ]]; then
        export PATH=$1:$PATH
    fi
}

addToPathFront $HOME/.local/.npm-global/bin
addToPathFront $HOME/.local/apps
addToPathFront $HOME/.local/scripts
addToPathFront $HOME/.local/bin
addToPathFront $HOME/.local/npm/bin

addToPathFront $HOME/.local/go/bin
addToPathFront /usr/local/go/bin
addToPath $HOME/.cargo/bin
addToPath $HOME/.local/personal

