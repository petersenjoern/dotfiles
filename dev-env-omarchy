#!/usr/bin/env bash
dry_run="0"

if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config home"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

if [[ $1 == "--dry" ]]; then
    dry_run="1"
fi

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

log "env: $DEV_ENV"

update_files() {
    log "copying over files from: $1"
    pushd "$1" &> /dev/null
    (
        configs=`find . -mindepth 0 -maxdepth 1 -type d`
        for c in $configs; do
            directory=${2%/}/${c#./}

            log "    copying env: cp $c $2"
            if [[ $dry_run == "0" ]]; then
                cp -r "./$c" "$2"
            fi
        done

    )
    popd &> /dev/null
}

copy() {
    log "copying: $1 to $2"
    if [[ $dry_run == "0" ]]; then
        cp "$1" "$2"
    fi
}

# local configs
if [[ $dry_run == "0" ]]; then
    rm -rf $XDG_CONFIG_HOME/nvim
else
    log "rm -rf $XDG_CONFIG_HOME/nvim"
fi
update_files $DEV_ENV/env/.config/nvim $XDG_CONFIG_HOME/nvim
update_files $DEV_ENV/env/.config/personal $XDG_CONFIG_HOME/personal
update_files $DEV_ENV/env/.config/repomix/ $XDG_CONFIG_HOME/repomix
update_files $DEV_ENV/env/.config/ghostty/ $XDG_CONFIG_HOME/ghostty
update_files $DEV_ENV/yazi $XDG_CONFIG_HOME/yazi
update_files $DEV_ENV/env/.local $HOME/.local/
if [[ $dry_run == "0" ]]; then
    rm $HOME/.local/scripts/dev-env # this is not to be confused with dev-env-omarchy
else
    log "rm $HOME/.local/scripts/dev-env"
fi

copy $DEV_ENV/env/.xprofile $HOME/.xprofile
copy $DEV_ENV/env/.tmux-sessionizer $HOME/.tmux-sessionizer

# zsh
copy $DEV_ENV/zsh/.zshrc $HOME/.zshrc
copy $DEV_ENV/zsh/.zsh_profile $HOME/.zsh_profile
copy $DEV_ENV/zsh/.p10k.zsh $HOME/.p10k.zsh
copy $DEV_ENV/zsh/.inputrc $HOME/.inputrc
mkdir -p "$HOME/.oh-my-zsh/custom/plugins/correction"
copy $DEV_ENV/zsh/correction.zsh $HOME/.oh-my-zsh/custom/plugins/correction/correction.plugin.zsh

# vscode
copy $DEV_ENV/vscode/settings.json $HOME/.config/Code/User/settings.json
copy $DEV_ENV/vscode/keybindings.json $HOME/.config/Code/User/keybindings.json

# alacritty
copy $DEV_ENV/alacritty/alacritty-omarchy.toml $HOME/.config/alacritty/alacritty.toml

# fzf
mkdir -p $HOME/.local/share/fzf
copy $DEV_ENV/fzf/key-bindings.zsh $HOME/.local/share/fzf/key-bindings.zsh
copy $DEV_ENV/fzf/completion.zsh $HOME/.local/share/fzf/completion.zsh

# git
copy $DEV_ENV/git/.gitconfig $HOME/.config/git/config
copy $DEV_ENV/git/.gitignore $HOME/.gitignore

# tmux
copy $DEV_ENV/tmux/.tmux.conf $HOME/.tmux.conf
if [[ $dry_run == "0" ]]; then
    tmux source-file $HOME/.tmux.conf
else
    log "tmux source-file $HOME/.tmux.conf"
fi

# claude code
copy $DEV_ENV/claude/CLAUDE.md $HOME/.claude/CLAUDE.md
copy $DEV_ENV/claude/settings.json $HOME/.claude/settings.json
copy $DEV_ENV/claude/statusline-command.sh $HOME/.claude/statusline-command.sh
update_files $DEV_ENV/claude/hooks $HOME/.claude/hooks
update_files $DEV_ENV/claude/commands $HOME/.claude/commands
mkdir -p $HOME/.claude/skills
update_files $DEV_ENV/claude/skills $HOME/.claude/skills

# hyprland (Omarchy 4 Lua configs; hyprland.lua/autostart.lua stay Omarchy-managed)
copy $DEV_ENV/key-mapping/input.lua $HOME/.config/hypr/input.lua
copy $DEV_ENV/hypr/bindings.lua $HOME/.config/hypr/bindings.lua
copy $DEV_ENV/hypr/monitors.lua $HOME/.config/hypr/monitors.lua
copy $DEV_ENV/hypr/looknfeel.lua $HOME/.config/hypr/looknfeel.lua

# ssh
mkdir -p $HOME/.ssh
copy $DEV_ENV/ssh/config $HOME/.ssh/config

# tig
copy $DEV_ENV/tig/.tigrc $HOME/.tigrc

# pi
mkdir -p $HOME/.pi
update_files $DEV_ENV/pi $HOME/.pi
copy $DEV_ENV/mouseless/config.yaml $HOME/.mouseless/configs/config.yaml

#systemd
copy $DEV_ENV/env/.config/systemd/user/backup-todo.timer $HOME/.config/systemd/user/backup-todo.timer
copy $DEV_ENV/env/.config/systemd/user/backup-todo.service $HOME/.config/systemd/user/backup-todo.service

#mise
copy $DEV_ENV/mise.toml $HOME/mise.toml

# atuin
mkdir -p $HOME/.config/atuin
copy $DEV_ENV/atuin/config.toml $HOME/.config/atuin/config.toml
