[includeIf "gitdir:~/repos/personal/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/repos/work/"]
    path = ~/.gitconfig-work
[color]
    branch = auto
    diff = auto
    status = auto
[merge]
    tool = kdiff3
[core]
    excludesfile = ~/.gitignore
    editor = vim
[push]
    default = simple
    # First push of a new branch auto-creates and tracks origin/<branch>,
    # so bare `git push`/`git pull` operate on the branch's own remote.
    autoSetupRemote = true
[pull]
  rebase = true
[filter "tabspace"]
    clean = expand --tabs=4 --initial
[filter "lfs"]
    smudge=git-lfs smudge -- %f
    process=git-lfs filter-process
    required=True

[color "diff"]
  meta = 0 123
  frag = 0
  old = 0 218
  oldMoved = 0 218
  new = 0 121
  newMoved = 0 183
  whitespace = red reverse

[color "status"]
  added = 2
  changed = 13
  untracked = 3
  branch = 12

[log]
  date = iso
[alias]
a = add -A
ap = !git add -p $(git status -s | cut -d' ' -f2- | fzf -m)
s = status -s
cm = commit -m
cam = commit -am
acm = !git add -A && git commit -m
feat = "!git commit -m \"feat: $1\" #"
chore = "!git commit -m \"chore: $1\" #"
fix = "!git commit -m \"fix: $1\" #"
ref = "!git commit -m \"refactor: $1\" #"
co = checkout
cop = "!git checkout $1 && git pull origin"
undo = reset --soft HEAD^
cob = checkout -b
ca = commit --amend
aca = !git add -A && git commit --amend
acan = !git add -A && git commit --amend --no-edit
c = commit
ri = rebase --interactive
rc = rebase --continue
rs = rebase --skip
b = branch
ba = branch -a
f = fetch
pu = push
fb = "!git checkout development && git cob $1"
zip = archive --format=zip -9
diffc = diff --cached
ai = add --interactive
branch-name = "!git rev-parse --abbrev-ref HEAD"
pub = "!git push -u origin $(git branch-name)"
pubto = "!git push -u $@ $(git branch-name) #"
pullo = "!git fetch && git reset --hard origin/$(git branch-name)"
pubt = "!git push --tags -u origin $(git branch-name)"
unpub = "!git push origin :$(git branch-name)"
gotag = !git tag -m "$1" -a
wipr = for-each-ref --sort='committerdate:iso8601' --format=' %(color:yellow)%(committerdate:relative)%09%(color:white)%(refname:short)' refs/remotes/origin
wip = for-each-ref --sort='committerdate:iso8601' --format=' %(color:yellow)%(committerdate:relative)%09%(color:white)%(refname:short)' refs/heads/
t = tag
td = tag -d
pr = "!gh pr create --fill"
sup = submodule update
most-recent-tag = "describe --tags --abbrev=0"
branch-name = "!git rev-parse --abbrev-ref HEAD"
rebase-master = !CURRENT=$(git branch-name) && git cop master && git co $CURRENT && git rebase master
rebase-main = !CURRENT=$(git branch-name) && git cop main && git co $CURRENT && git rebase main
# Check if the current branch has been merged into main/master.
# Fetches the remote first, picks main or master (preferring main),
# then reports whether HEAD is contained in that base branch.
merged = "!f() { \
  git fetch -q origin; \
  for b in main master; do \
    if git show-ref -q --verify refs/remotes/origin/$b; then base=origin/$b; break; fi; \
  done; \
  if [ -z \"$base\" ]; then echo 'No origin/main or origin/master found'; return 1; fi; \
  cur=$(git branch-name); \
  if git merge-base --is-ancestor HEAD \"$base\"; then \
    echo \"✓ '$cur' is merged into $base\"; \
  else \
    echo \"✗ '$cur' is NOT merged into $base\"; \
    ahead=$(git rev-list --count \"$base\"..HEAD); \
    echo \"  $ahead commit(s) on '$cur' not in $base\"; \
  fi; \
}; f"
# Safely prune local branches already merged into the default base.
# Fetches + prunes the remote, auto-detects origin/main or origin/master
# (preferring main), lists merged local branches — skipping any branch checked
# out in a worktree (incl. the current branch) and main/master — then asks for
# confirmation before deleting them with the safe `git branch -d`.
prune-merged = "!f() { \
  git fetch -q -p origin; \
  base=; \
  for b in main master; do \
    if git show-ref -q --verify refs/remotes/origin/$b; then base=origin/$b; break; fi; \
  done; \
  if [ -z \"$base\" ]; then echo 'No origin/main or origin/master found'; return 1; fi; \
  branches=$(git for-each-ref refs/heads/ --merged \"$base\" --format='%(refname:short) %(worktreepath)' | awk 'NF==1 {print $1}' | grep -vxE 'main|master'); \
  if [ -z \"$branches\" ]; then echo \"Nothing to prune (base $base).\"; return 0; fi; \
  n=$(printf '%s\\n' \"$branches\" | wc -l | tr -d ' '); \
  echo \"Merged into $base — would delete $n branch(es):\"; \
  printf '%s\\n' \"$branches\" | sed 's/^/  /'; \
  printf 'Delete? [y/N] '; \
  read ans; \
  case \"$ans\" in [yY]*) printf '%s\\n' \"$branches\" | while IFS= read -r br; do git branch -d \"$br\"; done;; *) echo 'Aborted.';; esac; \
}; f"
fco = "!git checkout $(git branch --sort='-committerdate:iso8601' | fzf)"
whoami = !git config user.name && git config user.email
l = log --graph --pretty=format:'%C(45)%s%Creset %C(white)%an, %ar%Creset %C(240)%h%Creset'

# typos
ad = add
bisec = bisect
bisetc = bisect
branhc = branch
breach = branch
breanch = branch
checkotu = checkout
checkou = checkout
checout = checkout
cherrypick = cherry-pick
cloen = clone
comit = commit
comitt = commit
committ = commit
dif = diff
fetc = fetch
fethc = fetch
greo = grep
grp = grep
grpe = grep
hceckout = checkout
mereg = merge
merg = merge
puhs = push
rbanch = branch
stat = status
statis = status
stats = status
statsu = status
statsus = status
statu = status
statys = status
stauts = status
sttus = status
submodules = submodule
tags = tag
