{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultModel": "coding",
  "defaultProvider": "aegis",
  "defaultTools": [
    "+codemode"
  ],
  "lastChangelogVersion": "1.3.0",
  "packages": [
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-web-tools",
    "npm:@narumitw/pi-firecrawl"
  ],
  "theme": "omarchy-system",
  "tuiMode": "regular",
  "defaultThinkingLevel": "high",
  "modelThinkingLevels": {
    "aegis/coding": "high",
    "aegis/fast": "low",
    "google-vertex/gemini-4-argon": "high",
    "google-vertex/gemini-3.8-flash": "low",
    "openrouter/deepseek/deepseek-v4-pro": "high",
    "openrouter/deepseek/deepseek-v4-flash": "low",
    "openrouter/z-ai/glm-5.2": "high",
    "openrouter/moonshotai/kimi-k3": "high",
    "ollama/gemma4:latest": "medium",
    "ollama/gemma4": "medium"
  },
  "thinkingBudgets": {
    "minimal": 512,
    "low": 1024,
    "medium": 2048,
    "high": 4096
  },
  "subagents": {
    "agentOverrides": {
      "implement": { "model": "aegis/coding", "thinking": "low" },
      "reviewer": { "model": "aegis/coding", "thinking": "high" },
      "scout": { "model": "aegis/fast" }
    }
  },
  "enabledModels": [
    "openrouter/deepseek/deepseek-v4-pro",
    "openrouter/deepseek/deepseek-v4-flash",
    "openrouter/z-ai/glm-5.2",
    "aegis/coding",
    "aegis/fast",
    "openrouter/moonshotai/kimi-k3",
    "ollama/gemma4:latest"
  ]
}
