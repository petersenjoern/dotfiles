# Loader only. Ghostty processes `config-file` includes *after* the rest of the
# file that names them, so an included file always beats a value written here.
# Overrides therefore live in their own include, listed last — later includes
# win over earlier ones. Keep this file free of settings.
#
# Both Omarchy paths are optional (?) and only one resolves: /usr/share is
# Omarchy 4, ~/.local/share is 3.x. They bring the font, the dynamic theme
# include, the keybinds and the hyprland async-backend fix.
config-file = ?"~/.local/share/omarchy/config/ghostty/config"
config-file = ?"/usr/share/omarchy/config/ghostty/config"
config-file = "personal.conf"
