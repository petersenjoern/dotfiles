#!/usr/bin/env bash

# File system
alias g="git"
alias ls="eza -lh --group-directories-first --icons=auto"
alias lsa="ls -a"
alias lt="eza --tree --level=2 --long --icons --git"
alias lta="lt -a"
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias ffm="fzf -m --preview 'bat --style=numbers --color=always {}'"
alias q="exit"

# Directories
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias ,,="cd .."
alias ..l="cd .. && ls"
alias :q="exit"
alias cd..="cd .."
alias mdkir="mkdir"
alias dc="cd"
alias sl="ls"
alias sudp="sudo"

alias nsmi=nvidia-smi
alias v=aws-vault
# aws-vault exec wrappers: `vp make invoke-task-step ...` == `v exec prod -- make ...`
vp() { aws-vault exec prod -- "$@"; }
vd() { aws-vault exec dev -- "$@"; }
alias cb="copy"
alias c="copy"
alias p="pasta"
alias vi="$EDITOR"
alias vim="$EDITOR"
alias nvim="$EDITOR"
alias gauth="gcloud auth application-default login"

alias opr="op run --env-file=.env.tpl --"


# Claude Code scratchpads (throwaway scripts Claude writes under /tmp/claude-<uid>)
alias cs="claude-scratch pick"
alias csl="claude-scratch ls"
alias cse="claude-scratch edit"
cscd() { cd "$(claude-scratch path)"; }

# Scripts execution
alias ctypecheck="claude -p 'Run pyright on the entire project. List all errors grouped by file. For each error, suggest a fix but do not edit files.' --allowedTools 'Read,Bash,Grep,Glob'"
