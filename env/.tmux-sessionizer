#!/usr/bin/env bash

if [[ "$(pwd)" == ${DOTFILES_REPOS_DIR:-$HOME/repos} ]]; then
    clear
    return
fi

window_exists() {
    tmux list-windows -F '#W' 2>/dev/null | grep -q "^$1$"
}

# 1. nvim window - rename the first window (created by tmux new-session)
if ! window_exists "nvim"; then
    tmux rename-window -t 1 nvim
    tmux send-keys -t nvim "nvim ." C-m
fi

# 2. scratchpad window (3 panes: 2 stacked left, 1 large right)
if ! window_exists "scratchpad"; then
    tmux new-window -dn scratchpad
    tmux split-window -t scratchpad -h
    tmux split-window -t scratchpad.1 -v
fi

# 3. cc window (4 equal panes, 2x2 grid)
if ! window_exists "cc"; then
    tmux new-window -dn cc
    tmux split-window -t cc -h
    tmux split-window -t cc.1 -v
    tmux split-window -t cc.2 -v
    tmux select-layout -t cc tiled
fi

# 3b. restore worktree windows from manifest (resurrect support)
if [[ -n "$(git rev-parse --show-toplevel 2>/dev/null)" ]]; then
    "$HOME/.local/scripts/tmux-worktree" restore --all 2>/dev/null
fi

# 4. todo window
if ! window_exists "todo"; then
    tmux new-window -dn todo
    tmux send-keys -t todo "nvim ${DOTFILES_TODO_PATH:-$HOME/repos/personal/TODO.md}" C-m
fi

# 5. services window (4 panes: be, fe, docker, dbeaver)
if ! window_exists "services"; then
    tmux new-window -dn services
    tmux split-window -t services -h
    tmux split-window -t services.1 -v
    tmux split-window -t services.2 -v
fi

# 6. cheatsheet window
if ! window_exists "cheatsheet"; then
    tmux new-window -dn cheatsheet
    tmux send-keys -t cheatsheet "nvim ${DEV_ENV:-$HOME/repos/personal/dotfiles}/cheatsheet.md" C-m
fi

