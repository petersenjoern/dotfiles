#!/usr/bin/env bash
# Usage: popup <name> [--preload]
# Show or hide an app in its own special workspace, launching it there first
# if no window matches. --preload only launches it, hidden.

# Hyprland doesn't run the shell profile, so load the gitignored per-machine values here
for conf in "$HOME/repos/personal/dotfiles/dotfiles.local.conf" "$HOME/.dotfiles.local.conf"; do
    [[ -f $conf ]] && source "$conf" && break
done

case $1 in
1password) class='^com.onepassword.OnePassword$' cmd='uwsm-app -- 1password' ;;
discord) class='^chrome-discord.com__' cmd='omarchy-launch-webapp https://discord.com/channels/@me' ;;
# Straight to the client: app.slack.com/'s Launch button opens a tab in the main browser
slack) class='^chrome-app.slack.com__' cmd='omarchy-launch-webapp "${DOTFILES_SLACK_URL:-https://app.slack.com/client}"' ;;
notion) class='^chrome-app.notion.com__' cmd='omarchy-launch-webapp "${DOTFILES_NOTION_URL:-https://app.notion.com}"' ;;
calendar) class='^chrome-calendar.google.com__' cmd='omarchy-launch-webapp https://calendar.google.com' ;;
email) class='^chrome-mail.google.com__' cmd='omarchy-launch-webapp https://mail.google.com' ;;
activity) class='^org.omarchy.btop$' cmd='omarchy-launch-tui btop' ;;
signal) class='^signal$' cmd='uwsm-app -- signal-desktop' ;;
# One nvim on TODO.md for every tmux session; the tmux session outlives the window
todo) class='^org.omarchy.todo$' cmd='omarchy-launch-tui --app-id=org.omarchy.todo tmux new-session -A -s todo nvim "${DOTFILES_TODO_PATH:-$HOME/repos/personal/TODO.md}"' ;;
*)
    echo "usage: popup <name> [--preload]" >&2
    exit 1
    ;;
esac

name=$1 preload=$2
win=$(hyprctl clients -j | jq -r --arg c "$class" 'first(.[] | select(.class | test($c))) | "\(.address) \(.workspace.name)"')

if [[ -z $win ]]; then
    "$(dirname "$0")/hypr-launch-to" "special:$name" "$cmd"
elif [[ ${win#* } != "special:$name" && $preload != --preload ]]; then
    hyprctl dispatch "hl.dsp.window.move({ window = \"address:${win%% *}\", workspace = \"special:$name\", follow = false })"
fi

[[ $preload == --preload ]] || hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$name\")"
