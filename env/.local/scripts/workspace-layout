#!/usr/bin/env bash
# Open my fixed workspace layout (bound to SUPER+SHIFT+W). Workspaces that
# already hold a window are skipped, so rerunning only fills the gaps.

layout=(
    "1|uwsm-app -- google-chrome-stable --new-window https://www.google.com"
    "2|omarchy-launch-terminal bash -c 'tmux attach || tmux'"
    "3|omarchy-launch-webapp https://github.com/"
    "4|omarchy-launch-webapp https://discord.com/channels/@me"
    "5|uwsm-app -- 1password"
    "7|omarchy-launch-tui btop"
    "8|omarchy-launch-webapp https://claude.ai"
    "9|uwsm-app -- nautilus --new-window"
)

addresses() { hyprctl clients -j | jq -r '.[].address' | sort; }

for entry in "${layout[@]}"; do
    ws=${entry%%|*}
    cmd=${entry#*|}

    if hyprctl clients -j | jq -e --argjson ws "$ws" 'any(.[]; .workspace.id == $ws)' >/dev/null; then
        continue
    fi

    before=$(addresses)
    setsid bash -c "$cmd" &>/dev/null &

    # Exec rules track the launched PID, which Chrome and uwsm-app hand off,
    # so wait for any new window and move that instead.
    for _ in {1..80}; do
        sleep 0.25
        new=$(comm -13 <(echo "$before") <(addresses) | head -1)
        [[ -n $new ]] && break
    done

    [[ -n $new ]] && hyprctl dispatch "hl.dsp.window.move({ window = \"address:$new\", workspace = \"$ws\", follow = false })"
done
