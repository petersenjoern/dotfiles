#!/usr/bin/env python3
"""tmux-worktree: manage git worktrees as tmux windows for Claude Code.

Keybindings (configured in .tmux.conf):
    prefix+T    create a new worktree window
    prefix+t    show overview of all worktree windows
    prefix+C-t  restore windows for worktrees that lost theirs
    prefix+X    remove a worktree window
    prefix+C-x  recycle a worktree window onto a fresh branch
    prefix+C-l  reapply the dev layout to a window whose panes have drifted
"""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

# ── Shell helpers ──────────────────────────────────────────────────────────────


def run(cmd: str, cwd: str | None = None, check: bool = True) -> str:
    """Run a shell command and return stripped stdout."""
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, cwd=cwd)
    if check and r.returncode != 0:
        return ""
    return r.stdout.strip()


def run_rc(cmd: str, cwd: str | None = None) -> tuple[int, str, str]:
    """Run a shell command and return (returncode, stdout, stderr)."""
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, cwd=cwd)
    return r.returncode, r.stdout.strip(), r.stderr.strip()


def tmux_split(
    target: str, wt_path: Path, *, horizontal: bool = False, percent: int
) -> str:
    """Split a tmux pane and return the new pane ID, retrying on failure."""
    direction = "-h" if horizontal else "-v"
    cmd = f"split-window -dPF '#{{pane_id}}' -t '{target}' {direction} -p {percent} -c '{wt_path}'"
    for attempt in range(3):
        pane_id = tmux(cmd)
        if pane_id:
            return pane_id
        time.sleep(0.1 * (attempt + 1))
        print(f"  retry split (attempt {attempt + 2}): {cmd}", file=sys.stderr)
    print(f"ERROR: split-window failed after 3 attempts: {cmd}", file=sys.stderr)
    return ""


def tmux(cmd: str) -> str:
    return run(f"tmux {cmd}")


def git(cmd: str, cwd: str | None = None) -> str:
    return run(f"git {cmd}", cwd=cwd)


# ── Project helpers ────────────────────────────────────────────────────────────


def get_project_root() -> Path:
    """Resolve the main git repo root, even if we're inside a worktree."""
    pane_path = tmux("display-message -p '#{pane_current_path}'")
    toplevel = git("rev-parse --show-toplevel", cwd=pane_path)
    if not toplevel:
        sys.exit("Error: not inside a git repository")

    toplevel = Path(toplevel)

    # If .git is a file (not dir), we're inside a worktree — follow to main repo
    git_path = toplevel / ".git"
    if git_path.is_file():
        gitdir = git_path.read_text().removeprefix("gitdir: ").strip()
        gitdir = (toplevel / gitdir).resolve()
        main_git = gitdir.parent.parent
        main_toplevel = git("rev-parse --show-toplevel", cwd=str(main_git.parent))
        if main_toplevel:
            toplevel = Path(main_toplevel)

    return toplevel


def ensure_worktrees_dir(project_root: Path) -> Path:
    """Create .worktrees/ dir and add it to .git/info/exclude."""
    wt_dir = project_root / ".worktrees"
    wt_dir.mkdir(exist_ok=True)

    exclude_file = project_root / ".git" / "info" / "exclude"
    if exclude_file.is_file():
        content = exclude_file.read_text()
        if ".worktrees/" not in content:
            with exclude_file.open("a") as f:
                f.write(".worktrees/\n")

    return wt_dir


# ── Manifest ───────────────────────────────────────────────────────────────────


def manifest_path(project_root: Path) -> Path:
    return project_root / ".worktrees" / "manifest.json"


def manifest_read(project_root: Path) -> list[dict]:
    path = manifest_path(project_root)
    if not path.is_file():
        return []
    return json.loads(path.read_text()).get("worktrees", [])


def manifest_write(project_root: Path, entries: list[dict]) -> None:
    path = manifest_path(project_root)
    path.parent.mkdir(exist_ok=True)
    path.write_text(json.dumps({"worktrees": entries}, indent=2) + "\n")


def manifest_add(
    project_root: Path, window: str, branch: str, rel_path: str, color: str
) -> None:
    entries = manifest_read(project_root)
    entries.append(
        {"window": window, "branch": branch, "path": rel_path, "color": color}
    )
    manifest_write(project_root, entries)


def manifest_remove(project_root: Path, window: str) -> None:
    entries = [e for e in manifest_read(project_root) if e["window"] != window]
    manifest_write(project_root, entries)


# ── Window helpers ─────────────────────────────────────────────────────────────


def list_wt_windows() -> list[str]:
    """Return sorted list of cc-wt-* window names."""
    all_windows = tmux("list-windows -F '#W'").splitlines()
    return sorted(w for w in all_windows if w.startswith("cc-wt-"))


def next_wt_number() -> int:
    """Find the next available cc-wt-N number."""
    nums = []
    for w in list_wt_windows():
        try:
            nums.append(int(w.removeprefix("cc-wt-")))
        except ValueError:
            continue
    return max(nums, default=0) + 1


# ── Window coloring ─────────────────────────────────────────────────────────────

# Stable palette of visually distinct tmux colors. Worktree N is tinted with
# COLOR_PALETTE[(N-1) % len(COLOR_PALETTE)], so the same worktree number always
# gets the same color across restores/resurrect.
COLOR_PALETTE = [
    "colour203",  # red
    "colour39",   # blue
    "colour78",   # green
    "colour170",  # magenta
    "colour215",  # orange
    "colour44",   # cyan
    "colour222",  # yellow
    "colour141",  # purple
]


def color_for_number(num: int) -> str:
    """Return the stable palette color for a given worktree number."""
    return COLOR_PALETTE[(num - 1) % len(COLOR_PALETTE)]


def apply_window_color(window: str, color: str) -> None:
    """Tint a worktree window: status-bar tab (via @wt_color) + pane borders.

    The status-bar formats in .tmux.conf read the per-window @wt_color user
    option; pane border styles are set directly as per-window overrides so the
    whole frame signals which worktree you're in.
    """
    tmux(f"set-window-option -t '{window}' @wt_color '{color}'")
    tmux(f"set-window-option -t '{window}' pane-active-border-style 'fg={color},bold'")
    tmux(f"set-window-option -t '{window}' pane-border-style 'fg={color}'")


# ── Worktree status ───────────────────────────────────────────────────────────


def worktree_status(wt_path: str) -> tuple[str, str]:
    """Return (icon, description) for a worktree's git status."""
    dirty = git("status --porcelain", cwd=wt_path)
    unpushed = git("log --oneline @{upstream}..HEAD", cwd=wt_path)

    dirty_count = len(dirty.splitlines()) if dirty else 0
    unpushed_count = len(unpushed.splitlines()) if unpushed else 0

    parts = []
    icon = "✓"

    if dirty_count:
        icon = "✗"
        parts.append(f"{dirty_count} uncommitted")
    else:
        parts.append("clean")

    if unpushed_count:
        parts.append(f"{unpushed_count} unpushed")
    elif not dirty_count:
        parts.append("pushed")

    return icon, ", ".join(parts)


# ── Env file symlinking ───────────────────────────────────────────────────────


def sync_env_files(project_root: Path, wt_path: Path) -> None:
    """Symlink .env* files from main worktree into the new worktree."""
    # Get list of tracked files to skip (they're already in the worktree)
    tracked = set(git("ls-files --full-name", cwd=str(project_root)).splitlines())

    # Find all .env* files in the main worktree
    env_files: list[Path] = []
    skip_dirs = {".worktrees", ".git", "node_modules", ".venv", "__pycache__"}
    for p in project_root.rglob(".env*"):
        # Skip anything inside .worktrees/, .git/, node_modules/, .venv/
        rel_parts = p.relative_to(project_root).parts
        if any(part in skip_dirs for part in rel_parts):
            continue
        # Accept regular files and FIFOs (1Password's "env" feature exposes
        # secrets via a named pipe its daemon populates on each open).
        if not (p.is_file() or p.is_fifo()):
            continue
        env_files.append(p)

    linked = 0
    for env_file in env_files:
        rel = env_file.relative_to(project_root)

        # Skip tracked files (already present in worktree via git)
        if str(rel) in tracked:
            continue

        target = wt_path / rel
        target.parent.mkdir(parents=True, exist_ok=True)

        if target.exists() or target.is_symlink():
            continue

        # Create relative symlink
        link_target = os.path.relpath(env_file, target.parent)
        target.symlink_to(link_target)
        linked += 1
        print(f"  Linked {rel}")

    if linked:
        print(f"  ({linked} env file{'s' if linked > 1 else ''} symlinked)")


# ── Auto env setup ─────────────────────────────────────────────────────────────


def auto_env_setup_commands(project_root: Path, wt_path: Path) -> list[str]:
    """Detect project type and return setup commands for the worktree."""
    hook = project_root / ".worktree-setup"
    if hook.is_file():
        return [f"source '{hook}'"]

    cmds = []

    if (wt_path / "mise.toml").exists() or (wt_path / ".mise.toml").exists():
        cmds.append("mise install")

    if (wt_path / "package.json").exists():
        if (wt_path / "pnpm-lock.yaml").exists():
            cmds.append("pnpm install")
        elif (wt_path / "yarn.lock").exists():
            cmds.append("yarn install")
        else:
            cmds.append("npm install")
    elif (wt_path / "pyproject.toml").exists():
        cmds.append("uv sync" if run("which uv", check=False) else "pip install -e .")
    elif (wt_path / "requirements.txt").exists():
        cmds.append(
            "uv pip install -r requirements.txt"
            if run("which uv", check=False)
            else "pip install -r requirements.txt"
        )

    return cmds


# ── Container teardown ──────────────────────────────────────────────────────────


def teardown_containers(wt_path: Path, wt_num: str, drop_volumes: bool) -> None:
    """Stop the per-worktree postgres containers (ai, app).

    Containers are isolated by compose project name (ai-wt-N / app-wt-N), so we
    pass the matching *_COMPOSE_PROJECT var to avoid touching the main repo's
    stack. mcp has no container of its own. Volumes are kept unless drop_volumes.
    """
    vol_flag = "-v" if drop_volumes else ""
    for svc in ("ai", "app"):
        svc_dir = wt_path / svc
        if not (svc_dir / "docker-compose.yml").exists():
            continue
        proj = f"{svc}-wt-{wt_num}"
        env_var = f"{svc.upper()}_COMPOSE_PROJECT"
        run(
            f"{env_var}={proj} docker compose down {vol_flag}",
            cwd=str(svc_dir),
            check=False,
        )
        print(f"  Stopped {proj}{' (volumes dropped)' if drop_volumes else ''}")


# ── Branch selection ──────────────────────────────────────────────────────────


def get_available_branches(project_root: Path) -> list[str]:
    """Return local and remote branches not already checked out by a worktree.

    Remote branches appear as 'origin/branch-name' after local branches.
    """
    # Get branches in use by worktrees
    wt_output = git("worktree list --porcelain", cwd=str(project_root))
    in_use: set[str] = set()
    for line in wt_output.splitlines():
        if line.startswith("branch refs/heads/"):
            in_use.add(line.removeprefix("branch refs/heads/"))

    # Local branches
    local_out = git(
        "branch --sort=-committerdate --format='%(refname:short)'",
        cwd=str(project_root),
    )
    local_branches = (
        [b.strip() for b in local_out.splitlines() if b.strip()] if local_out else []
    )
    local_set = set(local_branches)
    available_local = [b for b in local_branches if b not in in_use]

    # Remote branches (exclude HEAD pointer and branches that have a local counterpart)
    remote_out = git(
        "branch -r --sort=-committerdate --format='%(refname:short)'",
        cwd=str(project_root),
    )
    available_remote: list[str] = []
    if remote_out:
        for rb in remote_out.splitlines():
            rb = rb.strip()
            if not rb or "/HEAD" in rb:
                continue
            # e.g. "origin/feature" -> local name "feature"
            local_name = rb.split("/", 1)[1] if "/" in rb else rb
            if local_name not in local_set and local_name not in in_use:
                available_remote.append(rb)

    return available_local + available_remote


def select_branch(project_root: Path, branches: list[str]) -> tuple[str, str]:
    """Show fzf branch selector. Returns (action, branch).

    action is 'select', 'new', or 'cancel'.
    """
    preview_cmd = f"git -C '{project_root}' log --oneline -10 {{}}"

    try:
        result = subprocess.run(
            [
                "fzf",
                "--header=ctrl-n: create new branch",
                "--reverse",
                f"--preview={preview_cmd}",
                "--preview-window=right:50%",
                "--expect=ctrl-n",
            ],
            input="\n".join(branches),
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        sys.exit("Error: fzf not found")

    if result.returncode != 0 and not result.stdout.strip():
        return ("cancel", "")

    lines = result.stdout.splitlines()
    key = lines[0] if lines else ""
    selected = lines[1].strip() if len(lines) > 1 else ""

    if key == "ctrl-n":
        return ("new", "")
    elif selected:
        return ("select", selected)
    else:
        return ("cancel", "")


def prompt_branch(project_root: Path) -> tuple[bool, str | None]:
    """Interactive branch picker shared by create/recycle.

    Returns (cancelled, branch). branch is None when the user wants an
    auto-generated name (caller fills in the wt/N default).
    """
    branches = get_available_branches(project_root)
    if branches:
        action, selected = select_branch(project_root, branches)
        if action == "cancel":
            return (True, None)
        if action == "select":
            return (False, selected)
    branch_input = input(
        "Enter branch name (leave empty for auto-generated wt/N): "
    ).strip()
    return (False, branch_input or None)


# ── Window layout ─────────────────────────────────────────────────────────────

# The dev layout is defined once, by the percentages handed to split-window.
# create_dev_layout() builds a brand-new window from them; dev_layout_string()
# reproduces the identical geometry for a window that already exists, so
# `relayout` can repair a drifted window without touching its panes.
SPLIT_MAIN_PCT = 50  # vertical divider: nvim | claude
SPLIT_ROW_PCT = 30  # height of the shell / service row in both columns
SPLIT_SERVICE_PCT = 50  # horizontal divider in the service row: be | fe

# Pane roles in *layout-string order*, which is also the order tmux walks a
# window's pane list when assigning panes to cells.
LAYOUT_PANES = ("nvim", "shell", "claude", "be", "fe")


def layout_checksum(layout: str) -> str:
    """Reproduce tmux's layout_checksum(): 16-bit rotate-right, then add.

    tmux rejects a layout string whose leading checksum doesn't match the body.
    """
    csum = 0
    for ch in layout:
        csum = ((csum >> 1) + ((csum & 1) << 15)) & 0xFFFF
        csum = (csum + ord(ch)) & 0xFFFF
    return f"{csum:04x}"


def dev_layout_string(width: int, height: int, pane_ids: list[str]) -> str:
    """Build the tmux layout string for the 5-pane dev layout at width x height.

    Mirrors tmux's own split arithmetic (layout_split_pane): a `-p N` split
    gives the *new* pane `size * N / 100` and leaves the original with
    `(size - 1) - that`, the -1 being the divider line. Fed the same
    percentages create_dev_layout() splits with, this reproduces a freshly
    created window byte-for-byte.

    pane_ids are the numeric parts of the five %IDs in LAYOUT_PANES order.
    tmux ignores them when applying a layout — panes are assigned to cells in
    window order — but a well-formed string carries them.
    """
    right_w = (width * SPLIT_MAIN_PCT) // 100
    left_w = width - 1 - right_w
    row_h = (height * SPLIT_ROW_PCT) // 100
    top_h = height - 1 - row_h
    fe_w = (right_w * SPLIT_SERVICE_PCT) // 100
    be_w = right_w - 1 - fe_w

    rx = left_w + 1  # x of the right column
    ry = top_h + 1  # y of the bottom row
    fx = rx + be_w + 1  # x of the fe pane
    nvim, shell, claude, be, fe = pane_ids

    body = (
        f"{width}x{height},0,0{{"
        f"{left_w}x{height},0,0["
        f"{left_w}x{top_h},0,0,{nvim},"
        f"{left_w}x{row_h},0,{ry},{shell}],"
        f"{right_w}x{height},{rx},0["
        f"{right_w}x{top_h},{rx},0,{claude},"
        f"{right_w}x{row_h},{rx},{ry}{{"
        f"{be_w}x{row_h},{rx},{ry},{be},"
        f"{fe_w}x{row_h},{fx},{ry},{fe}}}]}}"
    )
    return f"{layout_checksum(body)},{body}"


def create_dev_layout(
    window_name: str, wt_path: Path, *, detached: bool = False
) -> dict[str, str]:
    """Create the 5-pane dev layout and return pane IDs.

    Layout:
    ┌──────────┬──────────┐
    │          │          │
    │   Nvim   │  Claude  │
    │          │          │
    ├──────────┼────┬─────┤
    │  Shell   │ BE │ FE  │
    └──────────┴────┴─────┘

    Returns dict with keys: nvim, claude, shell, be, fe (values are pane IDs).
    """
    p: dict[str, str] = {}

    # Always create window detached for reliable pane ID capture
    tmux(f"new-window -d -n '{window_name}' -c '{wt_path}'")
    p["nvim"] = tmux(f"list-panes -t '{window_name}' -F '#{{pane_id}}'")
    if not p["nvim"]:
        print(f"ERROR: failed to create window '{window_name}'", file=sys.stderr)
        return p

    # Keep dead panes visible for diagnostics until layout is confirmed
    tmux(f"set-option -t '{window_name}' remain-on-exit on")

    # Split right → claude pane (full-height vertical border, left keeps 50%)
    p["claude"] = tmux_split(
        p["nvim"], wt_path, horizontal=True, percent=SPLIT_MAIN_PCT
    )
    # Split nvim bottom → shell pane (30% of left column)
    p["shell"] = tmux_split(p["nvim"], wt_path, percent=SPLIT_ROW_PCT)
    # Split claude bottom → be pane (30% of right column)
    if p["claude"]:
        p["be"] = tmux_split(p["claude"], wt_path, percent=SPLIT_ROW_PCT)
    # Split be right → fe pane
    if p.get("be"):
        p["fe"] = tmux_split(
            p["be"], wt_path, horizontal=True, percent=SPLIT_SERVICE_PCT
        )

    # Wait for shells to initialize, then check for dead panes
    time.sleep(1.5)
    actual = tmux(f"list-panes -t '{window_name}' -F '#{{pane_id}} #{{pane_dead}}'")
    if actual:
        for line in actual.splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[1] == "1":
                dead_id = parts[0]
                name = next((n for n, pid in p.items() if pid == dead_id), "?")
                print(
                    f"WARNING: pane '{name}' ({dead_id}) died — respawning",
                    file=sys.stderr,
                )
                tmux(f"respawn-pane -t '{dead_id}' -c '{wt_path}'")

    # Verify all panes exist and are alive
    actual = tmux(f"list-panes -t '{window_name}' -F '#{{pane_id}}'")
    actual_ids = set(actual.splitlines()) if actual else set()
    for name, pane_id in list(p.items()):
        if not pane_id or pane_id not in actual_ids:
            print(f"WARNING: pane '{name}' missing (id={pane_id!r})", file=sys.stderr)
            p.pop(name, None)

    # Restore default behavior — dead panes will close normally from here
    tmux(f"set-option -t '{window_name}' remain-on-exit off")

    # Switch to window if not detached
    if not detached:
        tmux(f"select-window -t '{window_name}'")

    return p


# ── Subcommands ────────────────────────────────────────────────────────────────


def cmd_create(args: argparse.Namespace) -> None:
    project_root = get_project_root()

    if args.branch:
        branch = args.branch
    else:
        cancelled, branch = prompt_branch(project_root)
        if cancelled:
            return

    num = next_wt_number()
    wt_name = f"wt-{num}"
    window_name = f"cc-wt-{num}"
    color = color_for_number(num)
    if branch is None:
        branch = f"wt/{num}"

    wt_dir = ensure_worktrees_dir(project_root)
    wt_path = wt_dir / wt_name

    # Create worktree (existing local, remote tracking, or new branch)
    remote_ref = None
    if "/" in branch and git(
        f"show-ref --verify refs/remotes/{branch}", cwd=str(project_root)
    ):
        # Remote branch selected — create local tracking branch
        remote_ref = branch
        branch = branch.split("/", 1)[1]

    branch_exists = bool(
        git(f"show-ref --verify refs/heads/{branch}", cwd=str(project_root))
    )
    if branch_exists:
        git(f"worktree add '{wt_path}' '{branch}'", cwd=str(project_root))
    elif remote_ref:
        git(
            f"worktree add '{wt_path}' -b '{branch}' '{remote_ref}'",
            cwd=str(project_root),
        )
    else:
        git(f"worktree add '{wt_path}' -b '{branch}'", cwd=str(project_root))

    print(f"Created worktree: {wt_path} (branch: {branch})")

    # Symlink .env files from main worktree
    sync_env_files(project_root, wt_path)

    # Create tmux window with dev layout
    panes = create_dev_layout(window_name, wt_path)

    # Tint the window (status-bar tab + pane borders) for fast context switching
    apply_window_color(window_name, color)

    # Run env setup in shell pane
    if not args.no_setup and "shell" in panes:
        for cmd in auto_env_setup_commands(project_root, wt_path):
            tmux(f"send-keys -t '{panes['shell']}' '{cmd}' C-m")

    # Start nvim and claude in their panes
    if "nvim" in panes:
        tmux(f"send-keys -t '{panes['nvim']}' 'nvim .' C-m")
    if "claude" in panes:
        tmux(f"send-keys -t '{panes['claude']}' 'claude' C-m")
        tmux(f"select-pane -t '{panes['claude']}'")

    manifest_add(project_root, window_name, branch, f".worktrees/{wt_name}", color)
    print(f"Window {window_name} ready.")


def cmd_remove(args: argparse.Namespace) -> None:
    project_root = get_project_root()

    windows = list_wt_windows()
    if not windows:
        print("No worktree windows found.")
        input("Press Enter to close...")
        return

    # fzf selection with preview
    preview_script = (
        f"wt_num=$(echo {{}} | sed 's/cc-wt-//'); "
        f"wt_path='{project_root}/.worktrees/wt-'$wt_num; "
        f'if [ -d "$wt_path" ]; then '
        f'  branch=$(git -C "$wt_path" branch --show-current 2>/dev/null || echo unknown); '
        f"  echo \"Branch: $branch\"; echo ''; "
        f"  echo '--- Status ---'; git -C \"$wt_path\" status --short 2>/dev/null; "
        f"  echo ''; echo '--- Unpushed ---'; "
        f"  git -C \"$wt_path\" log --oneline @{{upstream}}..HEAD 2>/dev/null || echo '(no upstream)'; "
        f"else echo 'Directory not found'; fi"
    )

    try:
        result = subprocess.run(
            [
                "fzf",
                "--header=Select worktree to remove",
                f"--preview={preview_script}",
                "--preview-window=right:50%",
            ],
            input="\n".join(windows),
            capture_output=True,
            text=True,
        )
        selected = result.stdout.strip()
    except FileNotFoundError:
        sys.exit("Error: fzf not found")

    if not selected:
        return

    wt_num = selected.removeprefix("cc-wt-")
    wt_path = project_root / ".worktrees" / f"wt-{wt_num}"

    # Handle orphaned window (directory missing)
    if not wt_path.is_dir():
        print(f"Worktree directory not found: {wt_path}")
        print("Removing orphaned window...")
        tmux(f"kill-window -t '{selected}'")
        manifest_remove(project_root, selected)
        input("Press Enter to close...")
        return

    branch = git("branch --show-current", cwd=str(wt_path)) or "unknown"

    # Safety checks
    has_uncommitted = bool(git("status --porcelain", cwd=str(wt_path)))
    unpushed = git("log --oneline @{upstream}..HEAD", cwd=str(wt_path))
    has_unpushed = bool(unpushed)

    main_branch = git("symbolic-ref refs/remotes/origin/HEAD", cwd=str(project_root))
    main_branch = (
        main_branch.removeprefix("refs/remotes/origin/") if main_branch else ""
    )
    is_unmerged = False
    if main_branch and branch != main_branch:
        git("fetch origin", cwd=str(project_root))
        r = subprocess.run(
            f"git diff 'origin/{main_branch}...{branch}' --quiet",
            shell=True,
            capture_output=True,
            text=True,
            cwd=str(project_root),
        )
        is_unmerged = r.returncode != 0

    # Display summary
    print(f"\n  {selected} (branch: {branch})\n")

    if has_uncommitted:
        print("  ✗ Uncommitted changes detected")
        if not args.force:
            print("\n  Cannot remove: commit or stash changes first.")
            print("  Use --force to override.")
            input("  Press Enter to close...")
            return
    else:
        print("  ✓ Clean working tree")

    if has_unpushed:
        print("  ✗ Unpushed commits:")
        for line in unpushed.splitlines():
            print(f"      {line}")

    if is_unmerged:
        print(f"  ✗ Branch not merged into {main_branch}")

    print()
    confirm = input("  Remove? [y/N] ").strip().lower()
    if confirm != "y":
        print("  Cancelled.")
        return

    # Stop per-worktree containers before the worktree dir (and its compose
    # files) disappear. Keeps DB volumes unless --volumes was passed.
    teardown_containers(wt_path, wt_num, args.volumes)

    # Remove window and worktree
    tmux(f"kill-window -t '{selected}'")
    force_flag = "--force" if args.force else ""
    if not git(f"worktree remove '{wt_path}' {force_flag}", cwd=str(project_root)):
        git(f"worktree remove --force '{wt_path}'", cwd=str(project_root))

    # Clean up auto-generated branches that are fully merged
    if branch.startswith("wt/") and not is_unmerged:
        git(f"branch -d '{branch}'", cwd=str(project_root))

    manifest_remove(project_root, selected)
    print(f"  Removed {selected}.")


def cmd_restore(args: argparse.Namespace) -> None:
    """Restore tmux windows for worktrees that exist on disk but lost their window."""
    project_root = get_project_root()
    entries = manifest_read(project_root)

    # Find restorable entries: directory exists, window does not
    existing_windows = set(list_wt_windows())
    restorable = [
        e
        for e in entries
        if (project_root / e["path"]).is_dir() and e["window"] not in existing_windows
    ]

    if not restorable:
        if not args.all:
            print("No worktrees to restore — all manifest windows are active.")
            input("Press Enter to close...")
        return

    if args.all:
        selected = restorable
    elif len(restorable) == 1:
        selected = [restorable[0]]
    else:
        # Let user pick via fzf
        labels = [f"{e['window']}  ({e['branch']})" for e in restorable]
        try:
            result = subprocess.run(
                [
                    "fzf",
                    "--header=Select worktree(s) to restore (TAB to multi-select)",
                    "--multi",
                    "--reverse",
                ],
                input="\n".join(labels),
                capture_output=True,
                text=True,
            )
        except FileNotFoundError:
            sys.exit("Error: fzf not found")

        if result.returncode != 0 or not result.stdout.strip():
            return

        chosen = set(result.stdout.strip().splitlines())
        selected = [e for e, lbl in zip(restorable, labels) if lbl in chosen]

    for entry in selected:
        wt_window = entry["window"]
        full_path = project_root / entry["path"]

        sync_env_files(project_root, full_path)

        panes = create_dev_layout(wt_window, full_path, detached=True)

        # Re-apply the worktree tint (window options don't survive resurrect)
        color = entry.get("color") or color_for_number(
            int(wt_window.removeprefix("cc-wt-"))
        )
        apply_window_color(wt_window, color)

        if "shell" in panes:
            for cmd in auto_env_setup_commands(project_root, full_path):
                tmux(f"send-keys -t '{panes['shell']}' '{cmd}' C-m")

        if "nvim" in panes:
            tmux(f"send-keys -t '{panes['nvim']}' 'nvim .' C-m")
        if "claude" in panes:
            tmux(f"send-keys -t '{panes['claude']}' 'claude' C-m")
            tmux(f"select-pane -t '{panes['claude']}'")

        print(f"Restored {wt_window} (branch: {entry['branch']})")

    if not args.all:
        print(f"\n{len(selected)} window(s) restored.")
        input("Press Enter to close...")


def current_window_name() -> str:
    return tmux("display-message -p '#{window_name}'")


def select_wt_window(header: str) -> str | None:
    """Resolve which worktree window to act on: the current one, else fzf.

    Returns None when there is nothing to pick or the user cancelled.
    """
    cur = current_window_name()
    if cur.startswith("cc-wt-"):
        return cur

    windows = list_wt_windows()
    if not windows:
        print("No worktree windows found.")
        input("Press Enter to close...")
        return None
    if len(windows) == 1:
        return windows[0]

    try:
        result = subprocess.run(
            ["fzf", f"--header={header}", "--reverse"],
            input="\n".join(windows),
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        sys.exit("Error: fzf not found")
    return result.stdout.strip() or None


def find_layout_panes(window: str) -> dict[str, str]:
    """Identify the nvim / claude panes by their grid position.

    The dev layout puts nvim top-left and claude top-right, so within the
    top row the leftmost pane is nvim and the rightmost is claude. This is
    position-based so it survives across resurrect/restore (no stored IDs).
    """
    out = tmux(
        f"list-panes -t '{window}' -F '#{{pane_id}} #{{pane_left}} #{{pane_top}}'"
    )
    panes: list[tuple[str, int, int]] = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 3:
            panes.append((parts[0], int(parts[1]), int(parts[2])))
    if not panes:
        return {}
    min_top = min(t for _, _, t in panes)
    top_row = sorted((p for p in panes if p[2] == min_top), key=lambda p: p[1])
    result = {"nvim": top_row[0][0]}
    if len(top_row) > 1:
        result["claude"] = top_row[-1][0]
    return result


def cmd_recycle(args: argparse.Namespace) -> None:
    """Reuse an existing worktree window for a fresh branch off main.

    Keeps the window, panes, and long-running services (BE/FE/docker) warm.
    Only the nvim and claude panes are reset. Intended as the post-merge
    replacement for `remove` so you don't tear down a working environment.
    """
    project_root = get_project_root()

    # Target window: the current one if it's a worktree window, else fzf.
    window = select_wt_window("Select worktree window to recycle")
    if not window:
        return

    wt_num = window.removeprefix("cc-wt-")
    wt_path = project_root / ".worktrees" / f"wt-{wt_num}"
    if not wt_path.is_dir():
        sys.exit(f"Worktree directory not found: {wt_path}")

    old_branch = git("branch --show-current", cwd=str(wt_path)) or "unknown"

    # Safety: never recycle a dirty worktree (would silently lose work).
    if git("status --porcelain", cwd=str(wt_path)) and not args.force:
        print(f"  ✗ {old_branch} has uncommitted changes.")
        print("  Commit or stash first, or pass --force.")
        input("  Press Enter to close...")
        return

    # Resolve main branch and refresh remote refs so we branch off latest.
    main_branch = git("symbolic-ref refs/remotes/origin/HEAD", cwd=str(project_root))
    main_branch = (
        main_branch.removeprefix("refs/remotes/origin/") if main_branch else "main"
    )
    print("  Fetching origin…")
    git("fetch origin --prune", cwd=str(project_root))
    base = f"origin/{main_branch}"

    # Pick the next branch.
    if args.branch:
        new_branch: str | None = args.branch
    else:
        cancelled, new_branch = prompt_branch(project_root)
        if cancelled:
            return
    if new_branch is None:
        new_branch = f"wt/{wt_num}"

    # Remote selection (origin/foo -> local tracking branch foo).
    remote_ref = None
    if "/" in new_branch and git(
        f"show-ref --verify refs/remotes/{new_branch}", cwd=str(project_root)
    ):
        remote_ref = new_branch
        new_branch = new_branch.split("/", 1)[1]

    if new_branch == old_branch:
        print(f"  Already on {new_branch}; nothing to switch.")
        input("  Press Enter to close...")
        return

    # Switch the worktree's branch in place (services keep running).
    branch_exists = bool(
        git(f"show-ref --verify refs/heads/{new_branch}", cwd=str(project_root))
    )
    if branch_exists:
        rc, _, err = run_rc(f"git checkout '{new_branch}'", cwd=str(wt_path))
    elif remote_ref:
        rc, _, err = run_rc(
            f"git checkout -b '{new_branch}' --track '{remote_ref}'",
            cwd=str(wt_path),
        )
    else:
        # --no-track: the new branch is *cut from* origin/main but must not
        # *track* it. Without this, git's default autoSetupMerge sets
        # origin/main as upstream, which breaks bare push/pull. With
        # push.autoSetupRemote=true, the first `git push` creates and tracks
        # origin/<branch> instead (the conventional default).
        rc, _, err = run_rc(
            f"git checkout -b '{new_branch}' --no-track '{base}'", cwd=str(wt_path)
        )
    if rc != 0:
        sys.exit(f"  ✗ Failed to switch branch: {err}")
    print(f"  {window}: {old_branch} → {new_branch}")

    # Delete the just-merged branch if git agrees it's safe (-d, not -D).
    if old_branch not in (new_branch, main_branch, "unknown"):
        rc, _, _ = run_rc(f"git branch -d '{old_branch}'", cwd=str(project_root))
        if rc == 0:
            print(f"  Deleted merged branch {old_branch}")

    # Re-sync env symlinks (the new branch may reference new .env paths).
    sync_env_files(project_root, wt_path)

    # Reset only nvim + claude; leave BE/FE/docker panes running.
    panes = find_layout_panes(window)
    for pid in panes.values():
        tmux(f"respawn-pane -k -t '{pid}' -c '{wt_path}'")
    time.sleep(0.5)
    if "nvim" in panes:
        tmux(f"send-keys -t '{panes['nvim']}' 'nvim .' C-m")
    if "claude" in panes:
        tmux(f"send-keys -t '{panes['claude']}' 'claude' C-m")
        tmux(f"select-pane -t '{panes['claude']}'")

    # Update manifest branch entry for resurrect/restore.
    entries = manifest_read(project_root)
    for e in entries:
        if e["window"] == window:
            e["branch"] = new_branch
    manifest_write(project_root, entries)

    print(f"  {window} recycled onto {new_branch}.")


def cmd_relayout(args: argparse.Namespace) -> None:
    """Reapply the dev layout geometry to an existing worktree window.

    Pure geometry: nothing is respawned, killed or reordered, so nvim buffers,
    claude sessions and running dev servers all survive. Use it when a window's
    panes have drifted out of shape (a stray split, a manual resize, a
    resurrect that restored the panes but not the proportions).

    Panes fill the layout in their current window order, which is what a
    drifted window normally wants. If one lands in the wrong slot afterwards,
    `tmux swap-pane -d -s %A -t %B` moves it without disturbing the geometry.
    """
    if args.all:
        windows = list_wt_windows()
        if not windows:
            print("No worktree windows found.")
            input("Press Enter to close...")
            return
    else:
        window = args.window or select_wt_window("Select worktree window to relayout")
        if not window:
            return
        windows = [window]

    warned = False

    for window in windows:
        listing = tmux(
            f"list-panes -t '{window}' -F '#{{pane_id}} #{{pane_current_command}}'"
        )
        panes: list[tuple[str, str]] = []
        for line in listing.splitlines():
            parts = line.split(None, 1)
            if parts:
                panes.append((parts[0], parts[1] if len(parts) > 1 else "?"))

        if not panes:
            print(f"  ✗ {window}: no such window — skipped")
            warned = True
            continue
        if len(panes) != len(LAYOUT_PANES):
            print(
                f"  ✗ {window}: has {len(panes)} panes, "
                f"the dev layout needs {len(LAYOUT_PANES)} — skipped"
            )
            print("      Close the extras (prefix+x) or add one, then retry.")
            warned = True
            continue

        size = tmux(
            f"display-message -p -t '{window}' '#{{window_width}}x#{{window_height}}'"
        )
        try:
            width, height = (int(n) for n in size.split("x"))
        except ValueError:
            print(f"  ✗ {window}: could not read window size ({size!r}) — skipped")
            warned = True
            continue

        before = tmux(f"display-message -p -t '{window}' '#{{window_layout}}'")
        ids = [pid.lstrip("%") for pid, _ in panes]
        tmux(f"select-layout -t '{window}' '{dev_layout_string(width, height, ids)}'")
        after = tmux(f"display-message -p -t '{window}' '#{{window_layout}}'")

        if after == before:
            print(f"  ✓ {window}: already correct ({width}x{height})")
            continue

        print(f"  ✓ {window}: layout restored ({width}x{height})")
        for slot, (pid, cmd) in zip(LAYOUT_PANES, panes):
            print(f"      {slot:<7} {pid:<5} {cmd}")

    if warned or not args.all:
        input("\n  Press Enter to close...")


def cmd_overview(args: argparse.Namespace) -> None:
    project_root = get_project_root()
    wt_dir = project_root / ".worktrees"

    print(f"\n  Worktrees for {project_root.name}")
    print(f"  {'─' * 55}\n")

    windows = list_wt_windows()
    if not windows:
        print("  No worktree windows active.\n")
        print("  Press prefix+T to create one.")
        input("\n  Press Enter to close...")
        return

    main_branch = git("symbolic-ref refs/remotes/origin/HEAD", cwd=str(project_root))
    main_branch = (
        main_branch.removeprefix("refs/remotes/origin/") if main_branch else "main"
    )

    for window in windows:
        num = window.removeprefix("cc-wt-")
        wt_path = wt_dir / f"wt-{num}"

        if wt_path.is_dir():
            branch = git("branch --show-current", cwd=str(wt_path)) or "?"
            icon, status_msg = worktree_status(str(wt_path))
            # Flag windows whose branch is already merged into main (uses the
            # last-fetched origin ref, no network) so you know what to recycle.
            hint = ""
            if branch not in (main_branch, "?") and not git(
                "status --porcelain", cwd=str(wt_path)
            ):
                rc, _, _ = run_rc(
                    f"git diff 'origin/{main_branch}...{branch}' --quiet",
                    cwd=str(wt_path),
                )
                if rc == 0:
                    hint = "  ↺ recyclable"
            print(f"  {window:<12} {branch:<25} {icon} {status_msg}{hint}")
        else:
            print(f"  {window:<12} {'(missing)':<25} ⚠ directory not found")

    input("\n  Press Enter to close...")


# ── CLI ────────────────────────────────────────────────────────────────────────


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tmux-worktree",
        description="Manage git worktrees as tmux windows for Claude Code.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # create
    p_create = sub.add_parser("create", help="Create a new worktree and tmux window")
    p_create.add_argument(
        "-b", "--branch", help="Branch name (default: auto-generated wt/N)"
    )
    p_create.add_argument("--no-setup", action="store_true", help="Skip auto env setup")
    p_create.set_defaults(func=cmd_create)

    # remove
    p_remove = sub.add_parser("remove", help="Remove a worktree and its tmux window")
    p_remove.add_argument(
        "--force",
        action="store_true",
        help="Force removal even with uncommitted changes",
    )
    p_remove.add_argument(
        "--volumes",
        action="store_true",
        help="Also drop the worktree's postgres volumes (default: keep DB data)",
    )
    p_remove.set_defaults(func=cmd_remove)

    # recycle
    p_recycle = sub.add_parser(
        "recycle",
        help="Reuse a worktree window for a fresh branch (keeps services running)",
    )
    p_recycle.add_argument(
        "-b", "--branch", help="Branch to switch to (default: fzf/prompt)"
    )
    p_recycle.add_argument(
        "--force",
        action="store_true",
        help="Recycle even with uncommitted changes (loses them)",
    )
    p_recycle.set_defaults(func=cmd_recycle)

    # restore
    p_restore = sub.add_parser(
        "restore", help="Restore tmux windows for orphaned worktrees"
    )
    p_restore.add_argument(
        "--all",
        action="store_true",
        help="Restore all without fzf (for non-interactive use)",
    )
    p_restore.set_defaults(func=cmd_restore)

    # relayout
    p_relayout = sub.add_parser(
        "relayout",
        help="Reapply the dev layout geometry to a window whose panes drifted",
    )
    p_relayout.add_argument(
        "-w", "--window", help="Window name (default: current, else fzf)"
    )
    p_relayout.add_argument(
        "--all", action="store_true", help="Relayout every cc-wt-* window"
    )
    p_relayout.set_defaults(func=cmd_relayout)

    # overview
    p_overview = sub.add_parser("overview", help="Show status of all active worktrees")
    p_overview.set_defaults(func=cmd_overview)

    return parser


if __name__ == "__main__":
    args = build_parser().parse_args()
    args.func(args)
