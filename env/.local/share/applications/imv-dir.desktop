[Desktop Entry]
Name=Image Viewer (folder)
Comment=Open the clicked image with the rest of its folder, so arrow keys browse
Exec=sh -c "exec imv -n \\"\\$1\\" \\"\\$(dirname \\"\\$1\\")\\"" imv-dir %f
Icon=imv
Type=Application
NoDisplay=true
MimeType=image/png;image/jpeg;image/jpg;image/gif;image/bmp;image/webp;image/tiff;image/x-xcf;image/x-portable-pixmap;image/x-xbitmap;
Terminal=false
Categories=Graphics;Viewer;
